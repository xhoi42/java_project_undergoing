<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        ── What is pom.xml? ──────────────────────────────────────────────────
        pom.xml (Project Object Model) is the build configuration file for Maven.
        Maven is a build tool that:
          1. Downloads all libraries (dependencies) your project needs automatically
          2. Compiles your code
          3. Packages it into a runnable JAR file

        Think of it like package.json in Node.js.

        ── Spring Boot Parent ────────────────────────────────────────────────
        By declaring spring-boot-starter-parent as the parent, we inherit
        hundreds of sensible defaults: Java version, plugin versions,
        dependency versions that are known to work together.
        Without this you'd have to specify exact versions for every library.
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <!-- ── Project Identity ───────────────────────────────────────────────── -->
    <groupId>com.homedecor</groupId>
    <artifactId>home-decor-store</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Home Decor Store</name>
    <description>CS 305 Advanced Java - Home Decor E-Commerce Store</description>

    <!-- ── Java Version ───────────────────────────────────────────────────── -->
    <properties>
        <java.version>17</java.version>
    </properties>

    <!-- ── Dependencies ───────────────────────────────────────────────────── -->
    <!--
        Each <dependency> is a library Maven will download automatically
        from the internet (Maven Central repository) the first time you build.
        They are cached in ~/.m2 on your machine after the first download.
    -->
    <dependencies>

        <!--
            spring-boot-starter-web
            ─────────────────────────
            This single dependency pulls in:
              - Spring MVC (the @RestController, @GetMapping etc. annotations)
              - Tomcat (embedded web server — no need to install Tomcat separately)
              - Jackson (JSON serialization — converts Java objects ↔ JSON automatically)

            Without this, your @RestController annotations would not compile
            and there would be no web server to handle HTTP requests.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            spring-boot-starter-data-jpa
            ─────────────────────────────
            Pulls in:
              - Hibernate (the JPA implementation — maps Java objects to DB tables)
              - Spring Data JPA (repository interfaces — almost no SQL needed)
              - JDBC core

            This is what makes @Entity, @Table, @Column, EntityManager work.
            Without this, R7 (JPA/ORM) cannot be satisfied.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            mysql-connector-j
            ──────────────────
            The JDBC driver for MySQL.
            This is the "translator" that lets Java speak MySQL's protocol.
            Without this, DriverManager.getConnection() would throw
            "No suitable driver found" even if MySQL is running.

            R6 (JDBC) requires this to be present.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            spring-boot-starter-validation
            ────────────────────────────────
            Enables Bean Validation annotations: @NotNull, @NotBlank,
            @Min, @Max, @Email on your entity/request classes.
            Used in our JPA entity classes.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            lombok (optional but very useful)
            ──────────────────────────────────
            Generates boilerplate code at compile time via annotations:
              @Getter / @Setter    → generates all getters and setters
              @NoArgsConstructor   → generates a no-arg constructor
              @AllArgsConstructor  → generates a constructor with all fields
              @Builder             → generates a builder pattern automatically
              @ToString            → generates toString()

            Your JPA entity classes use this.
            If you prefer not to use Lombok, you can remove it and
            write the getters/setters manually — the logic stays the same.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            spring-boot-starter-test
            ─────────────────────────
            Pulls in JUnit 5, Mockito, AssertJ for writing tests.
            scope=test means it's only used during testing, not in production.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ── Build ──────────────────────────────────────────────────────────── -->
    <build>
        <plugins>
            <!--
                spring-boot-maven-plugin
                ─────────────────────────
                Allows you to run: mvn spring-boot:run
                Also packages everything into one executable "fat JAR":
                  mvn package → target/home-decor-store-1.0.0.jar
                  java -jar target/home-decor-store-1.0.0.jar
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>